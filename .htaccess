Options -Indexes
RewriteEngine On

# ── 301: legacy query-string URLs → clean paths ──────────────────────────────
RewriteCond %{QUERY_STRING} ^route=login(&|$)
RewriteRule ^$ /login? [R=301,L]

RewriteCond %{QUERY_STRING} ^route=register(&|$)
RewriteRule ^$ /register? [R=301,L]

RewriteCond %{QUERY_STRING} ^route=logout(&|$)
RewriteRule ^$ /logout? [R=301,L]

RewriteCond %{QUERY_STRING} ^route=forgot_password(&|$)
RewriteRule ^$ /forgot-password? [R=301,L]

RewriteCond %{QUERY_STRING} ^route=reset_password(&|$)
RewriteRule ^$ /reset-password? [R=301,L]

RewriteCond %{QUERY_STRING} ^route=admin_dashboard(&|$)
RewriteRule ^$ /admin? [R=301,L]

RewriteCond %{QUERY_STRING} ^route=travio-bangla(&|$)
RewriteRule ^$ /travio-bangla? [R=301,L]

# ── Clean URL → index.php front controller ────────────────────────────────────
# Skip real files and directories
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

RewriteRule ^login/?$          index.php [QSA,L]
RewriteRule ^register/?$       index.php [QSA,L]
RewriteRule ^logout/?$         index.php [QSA,L]
RewriteRule ^forgot-password/? index.php [QSA,L]
RewriteRule ^reset-password/?  index.php [QSA,L]
RewriteRule ^verify-email/?    index.php [QSA,L]
RewriteRule ^admin/?$          index.php [QSA,L]
RewriteRule ^travio-bangla/?$  index.php [QSA,L]
RewriteRule ^app/(.*)$         index.php [QSA,L]

# Catch-all: any other unknown path → homepage
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$             index.php [QSA,L]

# Security: block direct access to PHP includes
RewriteRule ^includes/         - [F,L]
